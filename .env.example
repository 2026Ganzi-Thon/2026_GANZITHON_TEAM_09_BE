# 행운핑 백엔드 환경변수 예시. 복사해서 .env로 쓴다(.env는 커밋하지 않는다).
# 값은 따옴표 없이, 등호 양옆 공백 없이 넣는다.

# ── DB ──
DB_URL=jdbc:postgresql://localhost:5432/haengunping
DB_USERNAME=haengunping
DB_PASSWORD=change-me

# ── 공공데이터포털: 행정안전부 대한민국 공공서비스(혜택) 정보 (help 모듈, 매일 04:00 동기화) ──
DATA_GO_KR_KEY=

# ── 웹 푸시 VAPID (notification 모듈) ──
# 키 쌍은 팀이 한 번 만들어 서버에만 넣는다. 개인키는 절대 커밋하지 않는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# ── 쿠키 ──
# local 프로필에서만 false 허용(사파리는 http에서 Secure 쿠키를 저장하지 않음). 그 외는 항상 true.
COOKIE_SECURE=true
