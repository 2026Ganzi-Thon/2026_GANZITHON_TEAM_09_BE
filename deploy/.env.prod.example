# 서버용 환경변수 예시. 서버에서 백엔드 폴더에 .env로 복사해 값을 채운다.
#   cp deploy/.env.prod.example .env && chmod 600 .env
# 값은 따옴표 없이, 등호 양옆 공백 없이 넣는다. 이 파일에 실제 값을 쓰지 않는다.

# ── 도메인 ── DuckDNS 등에서 서버 IP를 가리키게 한 이름
SITE_ADDRESS=haengunping.duckdns.org
# 시연용 프론트 목업 사이트(D-12). DuckDNS는 하위 이름도 같은 IP로 보낸다. 비우면 밖에서 닿지 않는다
DEMO_SITE_ADDRESS=demo.haengunping.duckdns.org

# ── 프론트 저장소 위치(백엔드 폴더 기준). deploy.sh가 여기서 빌드한다
FRONTEND_DIR=../frontend

# ── DB ── 비밀번호는 서버에서 만든다: openssl rand -base64 24
DB_USERNAME=haengunping
DB_PASSWORD=

# ── 공공데이터포털 (help 모듈, 매일 04:00 동기화)
DATA_GO_KR_KEY=

# ── 웹 푸시 VAPID (notification 모듈)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
