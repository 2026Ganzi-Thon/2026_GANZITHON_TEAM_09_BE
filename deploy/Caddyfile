# 행운핑 서버 프록시.
# - HTTPS 인증서를 자동으로 받는다(80·443 포트가 열려 있어야 함).
# - 화면과 API를 같은 도메인으로 묶는다(D-02: 쿠키·CSRF가 같은 출처를 전제).
# - Spring은 프록시 뒤라 HTTPS 여부를 모르므로 HSTS와 화면(HTML) CSP는 여기서 붙인다(D-11, SEC-07).
# - 사이트는 둘이다: SITE_ADDRESS(실서버, 출시 그대로)와 DEMO_SITE_ADDRESS(프론트 목업, D-12).

# 두 사이트 공통 헤더
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# 정적 화면(PWA). 없는 경로는 index.html로(클라이언트 라우팅). {args[0]}은 빌드 결과 폴더.
(static_app) {
	root * {args[0]}
	try_files {path} /index.html
	file_server

	# 스크립트·스타일·글꼴 모두 자기 출처만. 프론트가 글꼴을 직접 제공한다(2026-11-17, 구글 글꼴 제거).
	# font-src data: — 빌드가 작은 글꼴 조각을 CSS 안에 data:로 넣는다(빼면 일부 글자가 다른 글꼴로 보임).
	# img-src blob: — 추억 기록 사진을 줄일 때 고른 파일을 blob: 주소로 연다(빼면 사진 넣기 실패). 둘 다 이 페이지가 만든 것만 해당.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# 해시가 붙은 파일은 오래 캐시하고, 나머지(index.html·sw.js 등)는 매번 확인한다.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
}

# 실서버: 화면 + API
{$SITE_ADDRESS} {
	encode zstd gzip
	import security_headers

	# API. CSP·캐시 헤더는 Spring이 붙인다.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		import static_app /srv
	}
}

# 시연용 목업(D-12): 프론트를 VITE_API_MODE=mock으로 빌드한 정적 파일만. API로 넘기지 않는다.
# 데이터·시계가 방문한 기기 안에만 있어 실서버 사용자에게 영향이 없다.
{$DEMO_SITE_ADDRESS} {
	encode zstd gzip
	import security_headers
	# 검색에 실서버 대신 걸리지 않게
	header X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		respond 404
	}

	handle {
		import static_app /srv-demo
	}
}
