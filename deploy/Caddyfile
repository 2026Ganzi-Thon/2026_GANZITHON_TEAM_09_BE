# 행운핑 시연 서버 프록시.
# - HTTPS 인증서를 자동으로 받는다(80·443 포트가 열려 있어야 함).
# - 화면과 API를 같은 도메인으로 묶는다(D-02: 쿠키·CSRF가 같은 출처를 전제).
# - Spring은 프록시 뒤라 HTTPS 여부를 모르므로 HSTS와 화면(HTML) CSP는 여기서 붙인다(D-11, SEC-07).

{$SITE_ADDRESS} {
	encode zstd gzip

	# 모든 응답 공통
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API. CSP·캐시 헤더는 Spring이 붙인다.
	handle /api/* {
		reverse_proxy api:8080
	}

	# 화면(PWA 정적 파일). 없는 경로는 index.html로(클라이언트 라우팅).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# 스크립트는 자기 출처만. 글꼴만 Google Fonts를 허용한다(index.html이 불러옴).
		# connect-src의 글꼴 주소는 서비스 워커가 글꼴을 캐시할 때 쓴다(vite.config.ts runtimeCaching).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# 해시가 붙은 파일은 오래 캐시하고, 나머지(index.html·sw.js 등)는 매번 확인한다.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
	}
}
